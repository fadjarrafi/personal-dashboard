{
	"name": "Personal Dashboard",
	"short_name": "Dashboard",
	"description": "Bookmarks, notes, and snippets — capture fast, find fast.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#0f172a",
