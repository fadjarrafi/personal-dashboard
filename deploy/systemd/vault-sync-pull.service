[Unit]
Description=Pull Obsidian vault mirror from Google Drive + resync tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<user>
WorkingDirectory=/var/www/html/personal-dashboard
# Ganti "gdrive-vault" & path Drive kalau beda dari deploy/vault-sync-push.sh.
ExecStart=/usr/bin/rclone copy "gdrive-vault:Fadjar's Article Sync GDrive" /srv/vault-mirror --fast-list
# Sesuaikan path npm dengan output `which npm` di VPS (biasanya lewat nvm).
ExecStartPost=/home/<user>/.nvm/versions/node/v22/bin/npm run vault:resync
