[Unit]
Description=Pull Obsidian vault mirror from Google Drive + resync tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<user>
WorkingDirectory=/var/www/html/personal-dashboard
# `bun run` butuh `node` di PATH - systemd tidak load shell profile, dan tanpa
# node bun akan menjalankan skrip dengan runtime Bun (better-sqlite3 gagal load).
# Jadi tambahkan direktori bin nvm-nya di sini.
# Ganti <node-bin-dir> dengan hasil `dirname "$(which node)"`.
Environment="PATH=<node-bin-dir>:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Ganti "gdrive-vault" & path Drive kalau beda dari deploy/vault-sync-push.sh.
ExecStart=/usr/bin/rclone copy "gdrive-vault:rclone/Fadjar's Article Sync GDrive" /srv/vault-mirror --fast-list
# Sesuaikan path bun dengan output `which bun` di VPS.
ExecStartPost=/home/<user>/.bun/bin/bun run vault:resync
