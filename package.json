{
	"name": "personal-dashboard",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": "^22.23.4 || ^24.22.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env src/lib/server/db/migrate.ts",
		"db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
		"bills:remind": "tsx --env-file-if-exists=.env scripts/send-bill-reminders.ts",
		"vault:resync": "tsx --env-file-if-exists=.env scripts/vault-tasks-resync.ts",
		"test:extract:text": "tsx scripts/test-extract-text.ts",
		"test:extract:image": "tsx scripts/test-extract-image.ts"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"better-sqlite3": "^13.0.3",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.3.2",
		"marked": "^18.0.12",
		"tesseract.js": "^7.0.0",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/better-sqlite3": "^7.6.12",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.20",
		"daisyui": "^4.12.24",
		"drizzle-kit": "^0.31.10",
		"geist": "^1.7.2",
		"highlight.js": "^11.11.1",
		"pele": "^1.9.0",
		"postcss": "^8.5.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"svelte": "^5.19.0",
		"svelte-check": "^4.1.4",
		"svelte-dnd-action": "^0.9.79",
		"tailwindcss": "^3.4.17",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vite": "^6.0.7",
		"vite-plugin-pwa": "^0.21.1",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"esbuild": "^0.25.0",
		"lodash-es": "^4.18.1",
		"nanoid": "^3.3.19",
		"sass": "^1.79.0",
		"katex": "^0.18.2",
		"js-yaml": "^4.3.2"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"esbuild",
		"tesseract.js"
	]
}
