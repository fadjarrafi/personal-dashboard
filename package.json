{
	"name": "personal-dashboard",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:backup": "tsx scripts/backup.ts",
		"bills:remind": "tsx scripts/send-bill-reminders.ts",
		"test:extract:text": "tsx scripts/test-extract-text.ts",
		"test:extract:image": "tsx scripts/test-extract-image.ts"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"highlight.js": "^11.11.1",
		"tesseract.js": "^7.0.0",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.10.5",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.20",
		"daisyui": "^4.12.24",
		"drizzle-kit": "^0.31.10",
		"geist": "^1.7.2",
		"postcss": "^8.5.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"svelte": "^5.19.0",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^3.4.17",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vite": "^6.0.7",
		"vite-plugin-pwa": "^0.21.1",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"esbuild": "^0.25.0"
	}
}
