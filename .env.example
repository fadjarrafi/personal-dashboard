# --- Wajib ---
DATABASE_URL=./data/app.db
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Bill reminder (Web Push) ---
# Generate sekali via `npx web-push generate-vapid-keys` lalu simpan permanen -
# mengganti keypair meng-invalidate semua push subscription yang sudah ada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dark.fir21@gmail.com

# --- Vault sync (Obsidian, lihat docs/DEPLOY-vault-sync.md) ---
# Folder mirror lokal hasil `rclone copy` dari Google Drive - seluruh vault
# dibaca read-only dari sini, kecuali VAULT_DASHBOARD_FOLDER yang boleh ditulis.
VAULT_MIRROR_PATH=./data/vault-mirror
VAULT_DASHBOARD_FOLDER=Dashboard Sync
# Script yang di-exec setelah dashboard menulis file, untuk push balik ke Drive.
# Kosongkan di dev - tanpa ini note tetap tersimpan di mirror, hanya tidak ter-push.
VAULT_SYNC_PUSH_CMD=

# --- Produksi (adapter-node) ---
# Aktifkan / ubah saat deploy. Lihat docs/DEPLOY*.md.
# PORT=5173
# HOST=0.0.0.0
# ORIGIN=https://personal.example.com
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# BODY_SIZE_LIMIT=10485760
